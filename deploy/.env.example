# Copier ce fichier en .env (dans le même dossier que docker-compose.yml) et remplir les valeurs

# Mot de passe de la base Postgres (créée au premier démarrage, ne plus le changer ensuite)
POSTGRES_PASSWORD=

# Secret de signature des sessions : au moins 32 caractères aléatoires. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Le changer déconnecte tout le monde.
JWT_SECRET=

# Port du NAS sur lequel le site est accessible (http://ip-du-nas:8080)
JOKR_PORT=8080

# Coût du hachage des mots de passe (10 à 15). 12 = environ 0,25 s par connexion
SALTROUNDS=12

# Nombre de proxys devant JokR : 1 derrière le reverse proxy de DSM (HTTPS),
# 0 si le port est ouvert directement sur Internet
TRUST_PROXY=1

# Comptes administrateurs (page Statistiques) : noms d'utilisateur séparés par des virgules
ADMIN_USERNAMES=
