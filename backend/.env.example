# Copier ce fichier en .env et remplir les valeurs

PORT=3000

# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=jokr

# Origine autorisée pour le front (ex: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Nombre de tours bcrypt (entier entre 10 et 15)
SALTROUNDS=10

# Secret de signature des JWT : au moins 32 caractères aléatoires. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
