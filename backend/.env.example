# Copier ce fichier en .env et remplir les valeurs

PORT=3000

# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=jokr

# Origine autorisée pour le front (ex: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Nombre de tours bcrypt (entier entre 10 et 15)
SALTROUNDS=10

# Secret de signature des JWT : au moins 32 caractères aléatoires. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Connexion avec Google / Discord (facultatif : sans ces variables, les boutons ne s'affichent pas)
# Adresse du front, où Google et Discord renvoient le joueur (en dev : http://localhost:5173)
APP_URL=http://localhost:5173
# Google : https://console.cloud.google.com/apis/credentials → ID client OAuth "Application Web"
#   URI de redirection autorisée : <APP_URL>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord : https://discord.com/developers/applications → OAuth2
#   Redirect : <APP_URL>/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
